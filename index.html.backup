              </div>
            </div>
            <div class="progress-item">
              <div class="progress-header">
                <span class="progress-label">Porto Alegre — Alim. Domicílio 1S/25</span>
                <span class="progress-value" style="color:var(--rs)">+5,01%</span>
              </div>
