                <span class="progress-value" style="color:var(--primary)">+30,2%</span>
              </div>
              <div class="progress-bar-bg">
                <div class="progress-bar-fill" style="width:49.4%; background:var(--primary)"></div>
              </div>
            </div>
            <div class="progress-item">
              <div class="progress-header">
                <span class="progress-label">Curitiba — Alim. e Bebidas 2025</span>
                <span class="progress-value" style="color:var(--pr)">+2,80%</span>
              </div>
              <div class="progress-bar-bg">
