<script src="data.js"></script>
<script>
// ══════════════════════════════════════════
// UTILITÁRIOS
// ══════════════════════════════════════════
Chart.defaults.font.family = "'Inter', sans-serif";
Chart.defaults.font.size = 12;
Chart.defaults.color = '#6b7280';

const COLORS = {
  primary: '#1a56db',
  secondary: '#0e9f6e',
  danger: '#e02424',
  warning: '#f59e0b',
  purple: '#7e3af2',
  neutral: '#374151',
  rs: '#1a56db',
  pr: '#0e9f6e',
  sc: '#7e3af2',
  nacional: '#e02424',
  alimentacao: '#f59e0b'
};

function rgba(hex, alpha) {
  const r = parseInt(hex.slice(1,3),16);
  const g = parseInt(hex.slice(3,5),16);
  const b = parseInt(hex.slice(5,7),16);
  return `rgba(${r},${g},${b},${alpha})`;
}

// ══════════════════════════════════════════
// GRÁFICO 1 — VARIAÇÃO MENSAL
// ══════════════════════════════════════════
let chartMensalInstance;
function buildChartMensal(labels, values) {
  const ctx = document.getElementById('chartMensal').getContext('2d');
  if (chartMensalInstance) chartMensalInstance.destroy();
  chartMensalInstance = new Chart(ctx, {
    type: 'bar',
    data: {
      labels,
      datasets: [{
        label: 'Variação Mensal (%)',
        data: values,
        backgroundColor: values.map(v => v >= 0 ? rgba(COLORS.primary, 0.75) : rgba(COLORS.danger, 0.75)),
        borderColor: values.map(v => v >= 0 ? COLORS.primary : COLORS.danger),
        borderWidth: 1,
        borderRadius: 3,
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: { display: false },
        tooltip: {
          callbacks: {
            label: ctx => ` ${ctx.parsed.y.toFixed(2)}%`
          }
        },
        annotation: {
          annotations: {
            metaLine: {
              type: 'line',
              yMin: 0.25,
              yMax: 0.25,
              borderColor: rgba(COLORS.warning, 0.6),
              borderWidth: 1.5,
              borderDash: [5,4],
              label: {
                content: 'Meta mensal aprox.',
                display: false
              }
            }
          }
        }
      },
      scales: {
        x: {
          grid: { display: false },
          ticks: {
            maxRotation: 45,
            font: { size: 10 },
            maxTicksLimit: 24
          }
        },
        y: {
          grid: { color: rgba('#374151', 0.08) },
          ticks: {
            callback: v => v.toFixed(1) + '%'
          }
        }
      }
    }
  });
}

// Inicializar com todos os dados
buildChartMensal(ipcaData.ipcaGeral.labels, ipcaData.ipcaGeral.values);

// Filtro de período
function filterPeriod(btn, period) {
  document.querySelectorAll('#filterPeriod .filter-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  const all = ipcaData.ipcaGeral;
  let labels, values;
  const n = all.labels.length;
  if (period === 'all') {
    labels = all.labels; values = all.values;
  } else if (period === '2y') {
    labels = all.labels.slice(-24); values = all.values.slice(-24);
  } else if (period === '1y') {
    labels = all.labels.slice(-12); values = all.values.slice(-12);
  } else {
    const yr = period;
    const idx = all.labels.reduce((acc, l, i) => { if(l.includes('/'+yr.slice(2))) acc.push(i); return acc; }, []);
    labels = idx.map(i => all.labels[i]);
    values = idx.map(i => all.values[i]);
  }
  buildChartMensal(labels, values);
}

// ══════════════════════════════════════════
// GRÁFICO 2 — COMPARATIVO REGIONAL
// ══════════════════════════════════════════
const ctxRegional = document.getElementById('chartRegional').getContext('2d');
new Chart(ctxRegional, {
  type: 'line',
  data: {
    labels: ipcaData.ipcaAnual.anos,
    datasets: [
      {
        label: 'Brasil',
        data: ipcaData.ipcaAnual.brasil,
        borderColor: COLORS.nacional,
        backgroundColor: rgba(COLORS.nacional, 0.08),
        borderWidth: 2.5,
        pointRadius: 4,
        pointHoverRadius: 6,
        tension: 0.3,
        fill: false
      },
      {
        label: 'Porto Alegre (RS)',
        data: ipcaData.ipcaAnual.portoAlegre,
        borderColor: COLORS.rs,
        backgroundColor: rgba(COLORS.rs, 0.08),
        borderWidth: 2.5,
        pointRadius: 4,
        pointHoverRadius: 6,
        tension: 0.3,
        fill: false
      },
      {
        label: 'Curitiba (PR)',
        data: ipcaData.ipcaAnual.curitiba,
        borderColor: COLORS.pr,
        backgroundColor: rgba(COLORS.pr, 0.08),
        borderWidth: 2.5,
        pointRadius: 4,
        pointHoverRadius: 6,
        tension: 0.3,
        fill: false
      },
      {
        label: 'Florianópolis (SC)',
        data: ipcaData.ipcaAnual.florianopolis,
        borderColor: COLORS.sc,
        backgroundColor: rgba(COLORS.sc, 0.08),
        borderWidth: 2.5,
        pointRadius: 4,
        pointHoverRadius: 6,
        tension: 0.3,
        fill: false
      }
    ]
  },
  options: {
    responsive: true,
    maintainAspectRatio: false,
    plugins: {
      legend: {
        position: 'top',
        labels: { boxWidth: 12, font: { size: 11 } }
      },
      tooltip: {
        callbacks: {
          label: ctx => ` ${ctx.dataset.label}: ${ctx.parsed.y.toFixed(2)}%`
        }
      },
      annotation: {
        annotations: {
          meta: {
            type: 'line',
            yMin: 3.0,
            yMax: 3.0,
            borderColor: rgba(COLORS.warning, 0.5),
            borderWidth: 1.5,
            borderDash: [5,4]
          },
          teto: {
            type: 'line',
            yMin: 4.5,
            yMax: 4.5,
            borderColor: rgba(COLORS.danger, 0.4),
            borderWidth: 1.5,
            borderDash: [5,4]
          }
        }
      }
    },
    scales: {
      x: { grid: { display: false } },
      y: {
        grid: { color: rgba('#374151', 0.08) },
        ticks: { callback: v => v + '%' }
      }
    }
  }
});

// ══════════════════════════════════════════
// GRÁFICO 3 — IPCA POR CIDADE FEV/26
// ══════════════════════════════════════════
const ctxCidades = document.getElementById('chartCidades').getContext('2d');
const cidadesColors = [COLORS.pr, COLORS.rs, '#374151', '#6b7280', '#9ca3af', COLORS.danger];
new Chart(ctxCidades, {
  type: 'bar',
  data: {
    labels: ipcaData.ipcaCidadeFev2026.cidades,
    datasets: [{
      label: 'IPCA Fev/2026 (%)',
      data: ipcaData.ipcaCidadeFev2026.valores,
      backgroundColor: cidadesColors.map(c => rgba(c, 0.75)),
      borderColor: cidadesColors,
      borderWidth: 1.5,
      borderRadius: 6
    }]
  },
  options: {
    indexAxis: 'y',
    responsive: true,
    maintainAspectRatio: false,
    plugins: {
      legend: { display: false },
      tooltip: {
        callbacks: { label: ctx => ` ${ctx.parsed.x.toFixed(2)}%` }
      }
    },
    scales: {
      x: {
        grid: { color: rgba('#374151', 0.08) },
        ticks: { callback: v => v + '%' }
      },
      y: { grid: { display: false } }
    }
  }
});

// ══════════════════════════════════════════
// GRÁFICO 4 — ALIMENTAÇÃO vs GERAL
// ══════════════════════════════════════════
const ctxAlim = document.getElementById('chartAlimentacao').getContext('2d');
new Chart(ctxAlim, {
  type: 'line',
  data: {
    labels: ipcaData.comparacaoGeralAlimentacao.anos,
    datasets: [
      {
        label: 'IPCA Geral',
        data: ipcaData.comparacaoGeralAlimentacao.ipcaGeral,
        borderColor: COLORS.neutral,
        backgroundColor: rgba(COLORS.neutral, 0.06),
        borderWidth: 2.5,
        pointRadius: 5,
        pointHoverRadius: 7,
        tension: 0.3,
        fill: false
      },
      {
        label: 'Alimentação e Bebidas',
        data: ipcaData.comparacaoGeralAlimentacao.ipcaAlimentacao,
        borderColor: COLORS.alimentacao,
        backgroundColor: rgba(COLORS.alimentacao, 0.08),
        borderWidth: 2.5,
        pointRadius: 5,
        pointHoverRadius: 7,
        tension: 0.3,
        fill: false
      },
      {
        label: 'Alim. no Domicílio',
        data: ipcaData.comparacaoGeralAlimentacao.ipcaAlimDomicilio,
        borderColor: COLORS.secondary,
        backgroundColor: rgba(COLORS.secondary, 0.08),
        borderWidth: 2,
        pointRadius: 4,
        pointHoverRadius: 6,
        tension: 0.3,
        borderDash: [5,3],
        fill: false
      },
      {
        label: 'Alim. Fora do Domicílio',
        data: ipcaData.comparacaoGeralAlimentacao.ipcaAlimForaDomicilio,
        borderColor: COLORS.danger,
        backgroundColor: rgba(COLORS.danger, 0.06),
        borderWidth: 2,
        pointRadius: 4,
        pointHoverRadius: 6,
        tension: 0.3,
        borderDash: [3,3],
        fill: false
      }
    ]
  },
  options: {
    responsive: true,
    maintainAspectRatio: false,
    plugins: {
      legend: {
        position: 'top',
        labels: { boxWidth: 14, font: { size: 11 } }
      },
      tooltip: {
        callbacks: {
          label: ctx => ` ${ctx.dataset.label}: ${ctx.parsed.y.toFixed(2)}%`
        }
      },
      annotation: {
        annotations: {
          meta: {
            type: 'line',
            yMin: 3.0, yMax: 3.0,
            borderColor: rgba(COLORS.warning, 0.5),
            borderWidth: 1.5,
            borderDash: [5,4],
            label: {
              content: 'Meta 3%',
              display: true,
              position: 'end',
              font: { size: 10 },
              color: COLORS.warning,
              backgroundColor: 'transparent'
            }
          }
        }
      }
    },
    scales: {
      x: { grid: { display: false } },
      y: {
        grid: { color: rgba('#374151', 0.08) },
        ticks: { callback: v => v + '%' }
      }
    }
  }
});

// ══════════════════════════════════════════
// GRÁFICO 5 — TOP ALTAS 2025
// ══════════════════════════════════════════
const topItens = ipcaData.topItensAlimentacao2025;
const sortedIdx = topItens.variacoes
  .map((v,i) => ({v, i}))
  .sort((a,b) => b.v - a.v)
  .slice(0, 8);

const ctxTopAltas = document.getElementById('chartTopAltas').getContext('2d');
new Chart(ctxTopAltas, {
  type: 'bar',
  data: {
    labels: sortedIdx.map(x => topItens.itens[x.i]),
    datasets: [{
      label: 'Variação 2025 (%)',
      data: sortedIdx.map(x => x.v),
      backgroundColor: sortedIdx.map(x => x.v >= 0 ? rgba(COLORS.danger, 0.75) : rgba(COLORS.secondary, 0.75)),
      borderColor: sortedIdx.map(x => x.v >= 0 ? COLORS.danger : COLORS.secondary),
      borderWidth: 1.5,
      borderRadius: 4
    }]
  },
  options: {
    indexAxis: 'y',
    responsive: true,
    maintainAspectRatio: false,
    plugins: {
      legend: { display: false },
      tooltip: {
        callbacks: { label: ctx => ` ${ctx.parsed.x.toFixed(2)}%` }
      }
    },
    scales: {
      x: {
        grid: { color: rgba('#374151', 0.08) },
        ticks: { callback: v => v + '%', font: { size: 10 } }
      },
      y: {
        grid: { display: false },
        ticks: { font: { size: 10 } }
      }
    }
  }
});

// ══════════════════════════════════════════
// GRÁFICO 6 — TOP QUEDAS SUL 2025 (RS, PR, SC)
// ══════════════════════════════════════════
const quedas = ipcaData.quedaAlimentosCuritiba2025;
let currentRegionIndex = 1; // Índice padrão: Curitiba (PR)
let chartTopQuedasInstance;

function buildChartTopQuedas(regionIndex) {
  const ctxTopQuedas = document.getElementById('chartTopQuedas').getContext('2d');
  if (chartTopQuedasInstance) chartTopQuedasInstance.destroy();
  
  const cores = [COLORS.rs, COLORS.pr, COLORS.sc];
  const cor = cores[regionIndex];
  
  chartTopQuedasInstance = new Chart(ctxTopQuedas, {
    type: 'bar',
    data: {
      labels: quedas.itens[regionIndex],
      datasets: [{
        label: `Variação 2025 — ${quedas.regioes[regionIndex]} (%)`,
        data: quedas.variacoes[regionIndex],
        backgroundColor: rgba(cor, 0.75),
        borderColor: cor,
        borderWidth: 1.5,
        borderRadius: 4
      }]
    },
    options: {
      indexAxis: 'y',
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: { display: false },
        tooltip: {
          callbacks: { label: ctx => ` ${ctx.parsed.x.toFixed(2)}%` }
        }
      },
      scales: {
        x: {
          grid: { color: rgba('#374151', 0.08) },
          ticks: { callback: v => v + '%', font: { size: 10 } }
        },
        y: {
          grid: { display: false },
          ticks: { font: { size: 10 } }
        }
      }
    }
  });
}

// Inicializar com Curitiba (PR)
buildChartTopQuedas(1);

// Função para trocar entre regiões
function switchRegionQuedas(index) {
  currentRegionIndex = index;
  buildChartTopQuedas(index);
  // Atualizar botões de seleção
  document.querySelectorAll('#filterRegiao .filter-btn').forEach((btn, i) => {
    btn.classList.toggle('active', i === index);
  });
}

// ══════════════════════════════════════════
// GRÁFICO 7 — ACUMULADO 12 MESES
// ══════════════════════════════════════════
const ctxAcum = document.getElementById('chartAcumulado12m').getContext('2d');
new Chart(ctxAcum, {
  type: 'line',
  data: {
    labels: ipcaData.ipcaAcumulado12m.labels,
    datasets: [
      {
        label: 'IPCA Acumulado 12 meses (%)',
        data: ipcaData.ipcaAcumulado12m.values,
        borderColor: COLORS.primary,
        backgroundColor: rgba(COLORS.primary, 0.1),
        borderWidth: 2.5,
        pointRadius: 5,
        pointHoverRadius: 7,
        tension: 0.3,
        fill: true
      }
    ]
  },
  options: {
    responsive: true,
    maintainAspectRatio: false,
    plugins: {
      legend: { display: false },
      tooltip: {
        callbacks: { label: ctx => ` ${ctx.parsed.y.toFixed(2)}%` }
      },
      annotation: {
        annotations: {
          meta: {
            type: 'line',
            yMin: 3.0, yMax: 3.0,
            borderColor: rgba(COLORS.warning, 0.6),
            borderWidth: 1.5,
            borderDash: [5,4],
            label: {
              content: 'Meta: 3%',
              display: true,
              position: 'start',
              font: { size: 10 },
              color: COLORS.warning,
              backgroundColor: 'transparent'
            }
          },
          teto: {
            type: 'line',
            yMin: 4.5, yMax: 4.5,
            borderColor: rgba(COLORS.danger, 0.5),
            borderWidth: 1.5,
            borderDash: [5,4],
            label: {
              content: 'Teto: 4,5%',
              display: true,
              position: 'start',
              font: { size: 10 },
              color: COLORS.danger,
              backgroundColor: 'transparent'
            }
          }
        }
      }
    },
    scales: {
      x: { grid: { display: false } },
      y: {
        grid: { color: rgba('#374151', 0.08) },
        ticks: { callback: v => v + '%' },
        min: 3.0,
        max: 6.0
      }
    }
  }
});

// ══════════════════════════════════════════
// GRÁFICO 8 — GRUPOS DE DESPESA 2025
// ══════════════════════════════════════════
const gruposLabels = ['Alim. e Bebidas','Habitação','Art. Residência','Vestuário','Transportes','Saúde','Desp. Pessoais','Educação','Comunicação','IPCA Geral'];
const gruposValues = [2.95, 6.79, -0.28, 4.99, 3.07, 5.59, 5.87, 6.22, 0.77, 4.26];
const gruposColors = gruposValues.map(v => {
  if (v > 5) return rgba(COLORS.danger, 0.75);
  if (v > 3) return rgba(COLORS.warning, 0.75);
  if (v >= 0) return rgba(COLORS.primary, 0.75);
  return rgba(COLORS.secondary, 0.75);
});

const ctxGrupos = document.getElementById('chartGrupos2025').getContext('2d');
new Chart(ctxGrupos, {
  type: 'bar',
  data: {
    labels: gruposLabels,
    datasets: [{
      label: 'Variação 2025 (%)',
      data: gruposValues,
      backgroundColor: gruposColors,
      borderColor: gruposColors.map(c => c.replace('0.75', '1')),
      borderWidth: 1.5,
      borderRadius: 4
    }]
  },
  options: {
    indexAxis: 'y',
    responsive: true,
    maintainAspectRatio: false,
    plugins: {
      legend: { display: false },
      tooltip: {
        callbacks: { label: ctx => ` ${ctx.parsed.x.toFixed(2)}%` }
      },
      annotation: {
        annotations: {
          meta: {
            type: 'line',
            xMin: 3.0, xMax: 3.0,
            borderColor: rgba(COLORS.warning, 0.6),
            borderWidth: 1.5,
            borderDash: [5,4]
          }
        }
      }
    },
    scales: {
      x: {
        grid: { color: rgba('#374151', 0.08) },
        ticks: { callback: v => v + '%', font: { size: 10 } }
      },
      y: {
        grid: { display: false },
        ticks: { font: { size: 10 } }
      }
    }
  }
});

// ══════════════════════════════════════════
// GRÁFICO 9 — PESO DOS GRUPOS NO IPCA
// ══════════════════════════════════════════
const ctxPeso = document.getElementById('chartPeso').getContext('2d');
new Chart(ctxPeso, {
  type: 'doughnut',
  data: {
    labels: [
      'Alim. no Domicílio (15,36%)',
      'Alim. Fora Domicílio (6,08%)',
      'Habitação (14,74%)',
      'Transportes (20,54%)',
      'Saúde (13,43%)',
      'Desp. Pessoais (10,19%)',
      'Educação (6,00%)',
      'Vestuário (4,58%)',
      'Art. Residência (4,69%)',
      'Comunicação (4,39%)'
    ],
    datasets: [{
      data: [15.36, 6.08, 14.74, 20.54, 13.43, 10.19, 6.00, 4.58, 4.69, 4.39],
      backgroundColor: [
        rgba(COLORS.alimentacao, 0.85),
        rgba(COLORS.alimentacao, 0.5),
        rgba(COLORS.primary, 0.75),
        rgba(COLORS.neutral, 0.75),
        rgba(COLORS.danger, 0.65),
        rgba(COLORS.purple, 0.65),
        rgba(COLORS.secondary, 0.65),
        '#f3f4f6',
        '#e5e7eb',
        '#d1d5db'
      ],
      borderColor: '#fff',
      borderWidth: 2
    }]
  },
  options: {
    responsive: true,
    maintainAspectRatio: false,
    plugins: {
      legend: {
        position: 'right',
        labels: {
          boxWidth: 12,
          font: { size: 10 },
          padding: 8
        }
      },
      tooltip: {
        callbacks: {
          label: ctx => ` ${ctx.label}`
        }
      }
    },
    cutout: '55%'
  }
});

// ══════════════════════════════════════════
// TABS
// ══════════════════════════════════════════
function openTab(btn, tabId) {
  document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
  document.querySelectorAll('.tab-content').forEach(t => t.classList.remove('active'));
  btn.classList.add('active');
  document.getElementById(tabId).classList.add('active');
}
</script>
</body>
</html>
