<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Dashboard IPCA — Setor Alimentício | Sul do Brasil</title>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-annotation@3.0.1/dist/chartjs-plugin-annotation.min.js"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
  <style>
    :root {
      --primary: #1a56db;
      --primary-dark: #1e429f;
      --primary-light: #e8f0fe;
      --secondary: #0e9f6e;
      --danger: #e02424;
      --warning: #e3a008;
      --neutral: #374151;
      --neutral-light: #6b7280;
      --bg: #f9fafb;
      --card: #ffffff;
      --border: #e5e7eb;
      --rs: #1a56db;
      --pr: #0e9f6e;
      --sc: #7e3af2;
      --nacional: #e02424;
      --alimentacao: #f59e0b;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Inter', sans-serif;
      background: var(--bg);
      color: var(--neutral);
      min-height: 100vh;
    }

    /* ── HEADER ── */
    header {
      background: linear-gradient(135deg, #1a56db 0%, #1e429f 60%, #0e9f6e 100%);
      color: #fff;
      padding: 0;
      position: sticky;
      top: 0;
      z-index: 100;
      box-shadow: 0 2px 16px rgba(26,86,219,0.18);
    }
    .header-inner {
      max-width: 1400px;
      margin: 0 auto;
      padding: 18px 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 12px;
    }
    .header-logo {
      display: flex;
      align-items: center;
      gap: 14px;
    }
    .header-icon {
      width: 44px;
      height: 44px;
      background: rgba(255,255,255,0.18);
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 22px;
    }
    .header-title h1 {
      font-size: 1.25rem;
      font-weight: 700;
      letter-spacing: -0.3px;
    }
    .header-title p {
      font-size: 0.78rem;
      opacity: 0.82;
      margin-top: 2px;
    }
    .header-badges {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }
    .badge {
      background: rgba(255,255,255,0.18);
      border: 1px solid rgba(255,255,255,0.3);
      border-radius: 20px;
      padding: 4px 12px;
      font-size: 0.75rem;
      font-weight: 600;
      display: flex;
      align-items: center;
      gap: 5px;
    }
    .badge-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: #4ade80;
    }

    /* ── HERO STATS ── */
    .hero-stats {
      background: linear-gradient(180deg, #1e429f 0%, #1a56db 100%);
      padding: 28px 24px 36px;
    }
    .hero-stats-inner {
      max-width: 1400px;
      margin: 0 auto;
    }
    .hero-label {
      color: rgba(255,255,255,0.7);
      font-size: 0.8rem;
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-bottom: 16px;
    }
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 16px;
    }
    .stat-card {
      background: rgba(255,255,255,0.1);
      border: 1px solid rgba(255,255,255,0.2);
      border-radius: 14px;
      padding: 18px 20px;
      color: #fff;
      transition: background 0.2s;
    }
    .stat-card:hover { background: rgba(255,255,255,0.16); }
    .stat-label {
      font-size: 0.72rem;
      opacity: 0.75;
      text-transform: uppercase;
      letter-spacing: 0.8px;
      margin-bottom: 6px;
    }
    .stat-value {
      font-size: 2rem;
      font-weight: 800;
      line-height: 1;
      margin-bottom: 4px;
    }
    .stat-sub {
      font-size: 0.72rem;
      opacity: 0.7;
    }
    .stat-up { color: #fca5a5; }
    .stat-down { color: #86efac; }
    .stat-neutral { color: #fde68a; }

    /* ── MAIN LAYOUT ── */
    .main {
      max-width: 1400px;
      margin: 0 auto;
      padding: 32px 24px 60px;
    }

    /* ── SECTION TITLES ── */
    .section-header {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 20px;
      margin-top: 40px;
    }
    .section-header:first-child { margin-top: 0; }
    .section-icon {
      width: 36px;
      height: 36px;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 18px;
      flex-shrink: 0;
    }
    .section-icon.blue { background: var(--primary-light); }
    .section-icon.green { background: #d1fae5; }
    .section-icon.orange { background: #fef3c7; }
    .section-icon.purple { background: #ede9fe; }
    .section-title {
      font-size: 1.15rem;
      font-weight: 700;
      color: var(--neutral);
    }
    .section-subtitle {
      font-size: 0.8rem;
      color: var(--neutral-light);
      margin-top: 2px;
    }

    /* ── CARDS ── */
    .card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 24px;
      box-shadow: 0 1px 4px rgba(0,0,0,0.06);
    }
    .card-title {
      font-size: 0.9rem;
      font-weight: 600;
      color: var(--neutral);
      margin-bottom: 4px;
    }
    .card-subtitle {
      font-size: 0.75rem;
      color: var(--neutral-light);
      margin-bottom: 20px;
    }

    /* ── GRID LAYOUTS ── */
    .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
    .grid-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 20px; }
    .grid-auto { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px; }
    .col-span-2 { grid-column: span 2; }
    .col-span-3 { grid-column: span 3; }

    /* ── CHART CONTAINERS ── */
    .chart-container {
      position: relative;
      width: 100%;
    }
    .chart-container.tall { height: 360px; }
    .chart-container.medium { height: 280px; }
    .chart-container.short { height: 220px; }

    /* ── FILTER BAR ── */
    .filter-bar {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      margin-bottom: 20px;
    }
    .filter-btn {
      padding: 6px 16px;
      border-radius: 20px;
      border: 1.5px solid var(--border);
      background: #fff;
      font-size: 0.8rem;
      font-weight: 500;
      cursor: pointer;
      transition: all 0.18s;
      color: var(--neutral-light);
    }
    .filter-btn:hover { border-color: var(--primary); color: var(--primary); }
    .filter-btn.active {
      background: var(--primary);
      border-color: var(--primary);
      color: #fff;
    }
    .filter-btn.rs.active { background: var(--rs); border-color: var(--rs); }
    .filter-btn.pr.active { background: var(--pr); border-color: var(--pr); }
    .filter-btn.sc.active { background: var(--sc); border-color: var(--sc); }

    /* ── LEGEND ── */
    .legend {
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
      margin-top: 14px;
    }
    .legend-item {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 0.75rem;
      color: var(--neutral-light);
    }
    .legend-dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      flex-shrink: 0;
    }
    .legend-line {
      width: 18px;
      height: 3px;
      border-radius: 2px;
      flex-shrink: 0;
    }

    /* ── INSIGHT BOXES ── */
    .insights-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 16px;
      margin-top: 24px;
    }
    .insight-box {
      border-radius: 14px;
      padding: 18px 20px;
      border-left: 4px solid;
    }
    .insight-box.blue { background: #eff6ff; border-color: var(--primary); }
    .insight-box.green { background: #ecfdf5; border-color: var(--secondary); }
    .insight-box.orange { background: #fffbeb; border-color: var(--warning); }
    .insight-box.red { background: #fef2f2; border-color: var(--danger); }
    .insight-box.purple { background: #f5f3ff; border-color: #7e3af2; }
    .insight-title {
      font-size: 0.82rem;
      font-weight: 700;
      margin-bottom: 6px;
    }
    .insight-box.blue .insight-title { color: var(--primary-dark); }
    .insight-box.green .insight-title { color: #065f46; }
    .insight-box.orange .insight-title { color: #92400e; }
    .insight-box.red .insight-title { color: #991b1b; }
    .insight-box.purple .insight-title { color: #4c1d95; }
    .insight-text {
      font-size: 0.78rem;
      line-height: 1.55;
      color: var(--neutral);
    }

    /* ── ANALYSIS TABLE ── */
    .analysis-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.82rem;
    }
    .analysis-table th {
      background: var(--bg);
      padding: 10px 14px;
      text-align: left;
      font-weight: 600;
      color: var(--neutral-light);
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      border-bottom: 2px solid var(--border);
    }
    .analysis-table td {
      padding: 11px 14px;
      border-bottom: 1px solid var(--border);
      color: var(--neutral);
    }
    .analysis-table tr:last-child td { border-bottom: none; }
    .analysis-table tr:hover td { background: var(--bg); }
    .tag {
      display: inline-block;
      padding: 2px 8px;
      border-radius: 10px;
      font-size: 0.7rem;
      font-weight: 600;
    }
    .tag-up { background: #fef2f2; color: #991b1b; }
    .tag-down { background: #ecfdf5; color: #065f46; }
    .tag-neutral { background: #fffbeb; color: #92400e; }

    /* ── PROGRESS BARS ── */
    .progress-list { display: flex; flex-direction: column; gap: 12px; }
    .progress-item { }
    .progress-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 5px;
    }
    .progress-label { font-size: 0.8rem; font-weight: 500; }
    .progress-value { font-size: 0.8rem; font-weight: 700; }
    .progress-bar-bg {
      height: 8px;
      background: var(--border);
      border-radius: 4px;
      overflow: hidden;
    }
    .progress-bar-fill {
      height: 100%;
      border-radius: 4px;
      transition: width 0.8s ease;
    }

    /* ── FOOTER ── */
    footer {
      background: #1f2937;
      color: rgba(255,255,255,0.65);
      padding: 28px 24px;
      text-align: center;
      font-size: 0.78rem;
      line-height: 1.7;
    }
    footer strong { color: rgba(255,255,255,0.9); }

    /* ── TABS ── */
    .tabs {
      display: flex;
      gap: 0;
      border-bottom: 2px solid var(--border);
      margin-bottom: 24px;
    }
    .tab-btn {
      padding: 10px 20px;
      border: none;
      background: none;
      font-size: 0.85rem;
      font-weight: 500;
      color: var(--neutral-light);
      cursor: pointer;
      border-bottom: 2px solid transparent;
      margin-bottom: -2px;
      transition: all 0.18s;
    }
    .tab-btn:hover { color: var(--primary); }
    .tab-btn.active {
      color: var(--primary);
      border-bottom-color: var(--primary);
      font-weight: 600;
    }
    .tab-content { display: none; }
    .tab-content.active { display: block; }

    /* ── RESPONSIVE ── */
    @media (max-width: 900px) {
      .grid-2, .grid-3 { grid-template-columns: 1fr; }
      .col-span-2, .col-span-3 { grid-column: span 1; }
      .stats-grid { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 600px) {
      .header-inner { flex-direction: column; align-items: flex-start; }
      .stats-grid { grid-template-columns: 1fr 1fr; }
      .stat-value { font-size: 1.6rem; }
      .main { padding: 20px 14px 40px; }
    }

    /* ── TOOLTIP CUSTOM ── */
    .update-info {
      display: flex;
      align-items: center;
      gap: 8px;
      background: #ecfdf5;
      border: 1px solid #a7f3d0;
      border-radius: 10px;
      padding: 10px 16px;
      font-size: 0.78rem;
      color: #065f46;
      margin-bottom: 28px;
    }
    .update-info-icon { font-size: 16px; }

    /* ── DIVIDER ── */
    .divider {
      height: 1px;
      background: var(--border);
      margin: 36px 0;
    }

    /* Scrollbar */
    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-track { background: var(--bg); }
    ::-webkit-scrollbar-thumb { background: #d1d5db; border-radius: 3px; }
  </style>
</head>
<body>

<!-- ══════════════ HEADER ══════════════ -->
<header>
  <div class="header-inner">
    <div class="header-logo">
      <div class="header-icon">📊</div>
      <div class="header-title">
        <h1>Dashboard IPCA — Setor Alimentício</h1>
        <p>Monitoramento de inflação com foco em RS, SC e PR · Atualizado: Fev/2026</p>
      </div>
    </div>
    <div class="header-badges">
      <div class="badge"><span class="badge-dot"></span> Dados IBGE</div>
      <div class="badge">🍽️ Alimentação</div>
      <div class="badge">🗺️ Sul do Brasil</div>
    </div>
  </div>
</header>

<!-- ══════════════ HERO STATS ══════════════ -->
<div class="hero-stats">
  <div class="hero-stats-inner">
    <div class="hero-label">📌 Indicadores-chave · Fevereiro 2026</div>
    <div class="stats-grid">
      <div class="stat-card">
        <div class="stat-label">IPCA Nacional (Fev/26)</div>
        <div class="stat-value">0,70<span style="font-size:1.1rem">%</span></div>
        <div class="stat-sub stat-up">▲ Acumulado 12m: 3,81%</div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Alimentação e Bebidas (Fev/26)</div>
        <div class="stat-value">0,26<span style="font-size:1.1rem">%</span></div>
        <div class="stat-sub stat-down">▼ Abaixo do IPCA geral</div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Porto Alegre (RS) — Acum. 2025</div>
        <div class="stat-value">4,79<span style="font-size:1.1rem">%</span></div>
        <div class="stat-sub stat-up">▲ Acima da média nacional</div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Curitiba (PR) — Acum. 2025</div>
        <div class="stat-value">3,84<span style="font-size:1.1rem">%</span></div>
        <div class="stat-sub stat-down">▼ Abaixo da média nacional</div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Florianópolis (SC) — Acum. 2025</div>
        <div class="stat-value">5,17<span style="font-size:1.1rem">%</span></div>
        <div class="stat-sub stat-up">▲ Acima da média nacional</div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Alim. Fora do Domicílio 2025</div>
        <div class="stat-value">6,97<span style="font-size:1.1rem">%</span></div>
        <div class="stat-sub stat-up">▲ Acima da meta de inflação</div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Meta de Inflação 2025</div>
        <div class="stat-value">3,00<span style="font-size:1.1rem">%</span></div>
        <div class="stat-sub stat-neutral">Teto: 4,50% · IPCA: 4,26%</div>
      </div>
    </div>
  </div>
</div>

<!-- ══════════════ MAIN CONTENT ══════════════ -->
<div class="main">

  <!-- Update info -->
  <div class="update-info">
    <span class="update-info-icon">🔄</span>
    <span>
      <strong>Dados atualizados automaticamente</strong> conforme divulgações do IBGE.
      Próxima divulgação do IPCA: <strong>10/04/2026</strong> (referente a março/2026).
      Fontes: IBGE, Investidor10, Fecomércio PR, Udesc Esag, Fecomércio SC.
    </span>
  </div>

  <!-- ── SEÇÃO 1: EVOLUÇÃO GERAL ── -->
  <div class="section-header">
    <div class="section-icon blue">📈</div>
    <div>
      <div class="section-title">Evolução do IPCA — Variação Mensal</div>
      <div class="section-subtitle">Histórico mensal do índice nacional desde 2019 · Fonte: IBGE / Investidor10</div>
    </div>
  </div>

  <div class="filter-bar" id="filterPeriod">
    <button class="filter-btn active" onclick="filterPeriod(this, 'all')">Todo o período</button>
    <button class="filter-btn" onclick="filterPeriod(this, '2y')">Últimos 2 anos</button>
    <button class="filter-btn" onclick="filterPeriod(this, '1y')">Último ano</button>
    <button class="filter-btn" onclick="filterPeriod(this, '2025')">2025</button>
    <button class="filter-btn" onclick="filterPeriod(this, '2024')">2024</button>
    <button class="filter-btn" onclick="filterPeriod(this, '2022')">2022</button>
    <button class="filter-btn" onclick="filterPeriod(this, '2021')">2021</button>
  </div>

  <div class="card">
    <div class="card-title">Variação Mensal do IPCA — Brasil</div>
    <div class="card-subtitle">Percentual de variação mês a mês. Barras negativas indicam deflação.</div>
    <div class="chart-container tall">
      <canvas id="chartMensal"></canvas>
    </div>
    <div class="legend">
      <div class="legend-item"><div class="legend-dot" style="background:#1a56db"></div> Variação positiva</div>
      <div class="legend-item"><div class="legend-dot" style="background:#e02424"></div> Variação negativa</div>
      <div class="legend-item"><div class="legend-line" style="background:#f59e0b"></div> Meta de inflação (3%)</div>
    </div>
  </div>

  <!-- ── SEÇÃO 2: ANÁLISE DE IMPACTO ── -->
  <div class="section-header">
    <div class="section-icon orange">💼</div>
    <div>
      <div class="section-title">Análise de Impacto — Setor Alimentício no Sul do Brasil</div>
      <div class="section-subtitle">Como o IPCA influencia negociações e precificação no setor de alimentação</div>
    </div>
  </div>

  <!-- Tabs de análise -->
  <div class="card">
    <div class="tabs">
      <button class="tab-btn active" onclick="openTab(this, 'tab-negociacoes')">Negociações</button>
      <button class="tab-btn" onclick="openTab(this, 'tab-precos')">Precificação</button>
      <button class="tab-btn" onclick="openTab(this, 'tab-estrategias')">Estratégias</button>
      <button class="tab-btn" onclick="openTab(this, 'tab-perspectivas')">Perspectivas 2026</button>
    </div>

    <!-- Tab: Negociações -->
    <div id="tab-negociacoes" class="tab-content active">
      <div class="grid-2">
        <div>
          <h3 style="font-size:0.95rem; font-weight:700; margin-bottom:14px; color:var(--neutral)">
            📋 Como o IPCA Impacta as Negociações
          </h3>
          <table class="analysis-table">
            <thead>
              <tr>
                <th>Situação</th>
                <th>Indicador</th>
                <th>Impacto</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Contratos de fornecimento</td>
                <td>IPCA Alimentação 2025: 2,95%</td>
                <td><span class="tag tag-down">Favorável</span></td>
              </tr>
              <tr>
                <td>Reajuste de insumos</td>
                <td>Café moído: +35,65%</td>
                <td><span class="tag tag-up">Atenção</span></td>
              </tr>
              <tr>
                <td>Carnes bovinas</td>
                <td>Pico: +23,88% (set-dez/24)</td>
                <td><span class="tag tag-up">Pressão</span></td>
              </tr>
              <tr>
                <td>Alimentos básicos (arroz, feijão)</td>
                <td>Arroz: -26,56% / Feijão: -23,86%</td>
                <td><span class="tag tag-down">Alívio</span></td>
              </tr>
              <tr>
                <td>Alimentação fora do domicílio</td>
                <td>+6,97% em 2025</td>
                <td><span class="tag tag-up">Pressão</span></td>
              </tr>
              <tr>
                <td>Serviços de alimentação (lanche)</td>
                <td>+11,35% em 2025</td>
                <td><span class="tag tag-up">Alta</span></td>
              </tr>
              <tr>
                <td>Reajuste salarial (referência)</td>
                <td>IPCA 2025: 4,26%</td>
                <td><span class="tag tag-neutral">Referência</span></td>
              </tr>
            </tbody>
          </table>
        </div>
        <div>
          <h3 style="font-size:0.95rem; font-weight:700; margin-bottom:14px; color:var(--neutral)">
            📊 Alta Acumulada no Setor (2020–2025)
          </h3>
          <div class="progress-list">
            <div class="progress-item">
              <div class="progress-header">
                <span class="progress-label">Alimentação no Domicílio</span>
                <span class="progress-value" style="color:var(--danger)">+61,15%</span>
              </div>
              <div class="progress-bar-bg">
                <div class="progress-bar-fill" style="width:100%; background:var(--danger)"></div>
              </div>
            </div>
            <div class="progress-item">
              <div class="progress-header">
